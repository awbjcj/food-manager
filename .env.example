# Per-user default provider; users can switch with /llm. One of:
#   anthropic | openai | gemini | deepseek
# deepseek still can't read receipt photos (but does have native web search);
# if it is the default, also configure a key for an image-capable provider
# (anthropic/openai/gemini).
LLM_PROVIDER=anthropic
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
OPEN_REGISTRATION=false
WEB_APP_URL=https://your-public-domain.example
PORT=8000
BILLING_ENABLED=false
INGEST_PROVIDER=
OPERATOR_TELEGRAM_IDS=
OPERATOR_BOT_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5
ANTHROPIC_SEARCH_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Google Gemini (native google-genai SDK): full provider — image + web search + text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash
# DeepSeek (OpenAI-Responses-API-compatible): text tasks + native web search
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# --- sub2api gateway (subscription mode) ------------------------------------
# One gateway root shared by every provider; the *token* tells sub2api which
# upstream subscription to spend, so each provider gets its own. A provider
# with a token set here routes through the gateway by default; one without a
# token stays on its own metered API. Operators flip an individual provider at
# runtime with /provider <name> <api|subscription> on the operator bot.
# SUB2API_BASE_URL must use HTTPS. Leave it empty to disable subscription mode.
SUB2API_BASE_URL=
SUB2API_ANTHROPIC_TOKEN=
SUB2API_OPENAI_TOKEN=
SUB2API_GEMINI_TOKEN=
SUB2API_DEEPSEEK_TOKEN=
# /cook recipe engine
SPOONACULAR_API_KEY=
COOK_COST_CEILING_MICROS=100000
# /plan meal-planning engine
PLAN_COST_CEILING_MICROS=150000
DATABASE_PATH=./food.db
LOG_LEVEL=INFO
ENV=dev
