# Per-user default provider; users can switch with /llm. One of:
#   anthropic | openai | gemini | deepseek
# deepseek is text-only (no photo reading / web search); if it is the default,
# also configure a key for an image-capable provider (anthropic/openai/gemini).
LLM_PROVIDER=anthropic
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SEARCH_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TEXT_MODEL=gpt-5.6-luna
# Google Gemini (native google-genai SDK): full provider — image + web search + text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TEXT_MODEL=gemini-3.5-flash
# DeepSeek (OpenAI-compatible): text tasks only
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# /cook recipe engine
SPOONACULAR_API_KEY=
COOK_COST_CEILING_MICROS=100000
DATABASE_PATH=./food.db
LOG_LEVEL=INFO
ENV=dev
